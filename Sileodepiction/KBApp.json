          "title": "Features",
          "useBoldText": true,
          "useBottomMargin": true
        },
        {
          "class": "DepictionMarkdownView",
          "markdown": "<ul><li>Launch apps from the keyboard dock</li><li>Copy, cut, paste, select all, undo / redo</li><li>Cursor moves, delete, dismiss keyboard</li><li>Translate the selection or the whole field</li><li>Favorite words — insert in one tap</li><li>Clipboard history</li><li>Groups and custom buttons</li><li>Spacing, icon size, and distance from the bottom</li><li>Custom / system / keep-image module colors</li></ul>",
          "useRawFormat": true
